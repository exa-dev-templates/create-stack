#!/bin/sh
# Multi-ecosystem pre-commit hook
# Validates code health, types, and formatting for changed files before allowing commit.

set -e

# Ensure developer bin paths are available in hook environment
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.cargo/bin:/opt/miniconda3/bin:$PATH"
if [ -d "$HOME/.nvm/versions/node" ]; then
    LATEST_NODE=$(ls -1d "$HOME/.nvm/versions/node"/v* 2>/dev/null | tail -n 1)
    [ -n "$LATEST_NODE" ] && export PATH="$LATEST_NODE/bin:$PATH"
fi
if [ -d "$HOME/.gvm/gos" ]; then
    LATEST_GO=$(ls -1d "$HOME/.gvm/gos"/go* 2>/dev/null | tail -n 1)
    [ -n "$LATEST_GO" ] && export PATH="$LATEST_GO/bin:$PATH"
fi

RED='\033[1;31m'
GREEN='\033[1;32m'
CYAN='\033[1;36m'
YELLOW='\033[1;33m'
RESET='\033[0m'

echo "${CYAN}🔍 [Git Pre-commit Hook] Memeriksa perubahan kode...${RESET}"

STAGED_FILES=$(git diff --cached --name-only)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

FAILED=0

# 1. Check Node / TypeScript templates
for dir in template-express template-react template-vue template-worker-typescript; do
    if echo "$STAGED_FILES" | grep -q "^$dir/"; then
        echo "  📐 Memverifikasi TypeScript pada $dir..."
        if ! (cd "$dir" && npm run typecheck >/dev/null 2>&1); then
            echo "${RED}  ❌ Typecheck gagal pada $dir! Jalankan 'npm run typecheck' di folder tersebut untuk melihat error.${RESET}"
            FAILED=1
        else
            echo "${GREEN}  ✅ Typecheck $dir: LOLOS${RESET}"
        fi
    fi
done

# 2. Check Rust templates
for dir in template-rust template-worker-rust; do
    if echo "$STAGED_FILES" | grep -q "^$dir/"; then
        echo "  🦀 Memverifikasi Rust pada $dir..."
        if ! (cd "$dir" && cargo fmt --check >/dev/null 2>&1 && cargo check --quiet >/dev/null 2>&1); then
            echo "${RED}  ❌ Format/check gagal pada $dir! Jalankan 'cargo fmt' dan 'cargo check'.${RESET}"
            FAILED=1
        else
            echo "${GREEN}  ✅ Rust check $dir: LOLOS${RESET}"
        fi
    fi
done

# 3. Check Go templates
for dir in template-golang template-worker-golang; do
    if echo "$STAGED_FILES" | grep -q "^$dir/"; then
        echo "  🐹 Memverifikasi Go pada $dir..."
        if ! (cd "$dir" && go mod verify >/dev/null 2>&1 && go vet ./... >/dev/null 2>&1); then
            echo "${RED}  ❌ Verifikasi Go gagal pada $dir! Jalankan 'go mod verify' dan 'go vet ./...'.${RESET}"
            FAILED=1
        else
            echo "${GREEN}  ✅ Go check $dir: LOLOS${RESET}"
        fi
    fi
done

# 4. Check Python templates
for dir in template-fastapi-async template-worker-python; do
    if echo "$STAGED_FILES" | grep -q "^$dir/"; then
        echo "  🐍 Memverifikasi Python syntax pada $dir..."
        if ! (cd "$dir" && python3 -m compileall -q . >/dev/null 2>&1); then
            echo "${RED}  ❌ Syntax error Python terdeteksi pada $dir!${RESET}"
            FAILED=1
        else
            echo "${GREEN}  ✅ Python check $dir: LOLOS${RESET}"
        fi
    fi
done

if [ "$FAILED" -ne 0 ]; then
    echo "\n${RED}⛔ [COMMIT DITOLAK] Perbaiki error di atas sebelum melakukan commit.${RESET}\n"
    exit 1
fi

echo "${GREEN}✅ [Git Pre-commit Hook] Semua pemeriksaan lolos!${RESET}\n"
exit 0
